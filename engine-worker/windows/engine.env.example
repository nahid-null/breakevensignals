# Local Windows configuration. Never upload the real engine.env or paste its contents into chat.
# Use the published website origin; no trailing path. Setup prompts for the matching engine key.
ENGINE_APP_URL=
ENGINE_SHARED_SECRET=
ENGINE_HOST_KIND=windows_pc
LOCAL_HEALTH_SECRET=
SUPERVISOR_PORT=8787
ENGINE_HEALTH_PORT=8788
# Optional absolute log folder. Default is logs under the installed application.
ENGINE_LOG_DIR=